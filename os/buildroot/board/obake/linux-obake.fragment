# Host requirements every obake board needs on top of its base kernel config.
#
# The generic boards use a full custom config that already sets these; the
# rk35xx board builds from the architecture default config and relies on this
# fragment to guarantee the writable contract, the Singularity runtime, the
# EFI/vfat ESP, and RAUC's dm-verity bundles all have their kernel support.
#
# The kernel local version (-<board>-<rev>) is injected at build time via the
# LOCALVERSION make variable. Board linux.config files leave CONFIG_LOCALVERSION
# empty so it is not prefixed again. Do not enable AUTO (the kernel input is a
# tarball).
# CONFIG_LOCALVERSION_AUTO is not set

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BINFMT_MISC=y

# Loop devices and SquashFS, needed by the Singularity runtime for SIF images.
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# Initramfs support, required to run the obake /etc-overlay init.
CONFIG_BLK_DEV_INITRD=y

# FAT/MSDOS/VFAT for the EFI system partition and removable update media;
# exFAT for common USB sticks.
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Device-mapper verity, required to mount RAUC verity-format bundles.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_BUFIO=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y

# Writable contract: the /etc overlay, the /var tmpfs, and FUSE.
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_FUSE_FS=y

# Extended attributes for onboard filesystems that expose a kernel option.
# SquashFS: many SIFs (library://, docker-derived) ship xattrs; without this
# the mount works but dmesg reports ignored xattrs / missing id index table.
# ext4: POSIX ACLs and security.* labels (e.g. file capabilities).
# tmpfs: /var and other tmpfs mounts. Overlay/FUSE have no separate host
# xattr toggle (stacked / userspace). FAT/exFAT have no Linux xattr Kconfig.
CONFIG_SQUASHFS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# Namespaces for Singularity (setuid fakeroot / optional userns flows).
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUP_NS=y

# POSIX message queues: Singularity mounts mqueue into the container session
# (required for --fakeroot on boards whose base config omits it).
CONFIG_POSIX_MQUEUE=y

# Cgroup controllers for container workloads. Do not enable RT_GROUP_SCHED
# (conflicts with PREEMPT_RT).
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
