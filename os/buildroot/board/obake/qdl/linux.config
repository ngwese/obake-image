# MeLE Quieter DL (Intel N100, dual RTL8125). Minimal custom config for bare
# metal; MIDI 2.0 and AOIP network plumbing. PREEMPT_RT / HZ / NO_HZ come from
# linux-realtime.fragment. Host contract options match generic-x86_64 (also
# reinforced by linux-obake.fragment). No wireless.
#
# Guided by curieux quieter_dl_aoip_defconfig hardware enablement; not a paste.

CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_SMP=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_NR_CPUS=8

# BPF required by XDP sockets (AOIP plumbing).
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_XDP_SOCKETS=y
CONFIG_NETWORK_PHY_TIMESTAMPING=y
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set

CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_ACPI=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Storage: NVMe root + microSD reader.
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y

# Dual Realtek RTL8125 2.5GbE. The out-of-tree r8125 module (with hardware
# timestamping) is built by the qdl package; in-tree r8169 is omitted so it
# cannot bind 10ec:8125. Intel Ethernet is omitted (this board enumerates
# 10ec:8125, not 8086:125c); platform Intel drivers stay below.
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
# CONFIG_NET_VENDOR_INTEL is not set
CONFIG_NET_VENDOR_REALTEK=y
# CONFIG_R8169 is not set
CONFIG_PTP_1588_CLOCK=y

CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_INTEL=y
CONFIG_INTEL_MEI=m
CONFIG_INTEL_MEI_ME=m

# USB host (MIDI 2.0 devices attach here).
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_ACPI=m

# Audio: onboard HDA + USB MIDI 2.0 / UMP. No legacy PCI sound-card zoo.
# DRM_I915 is unavailable with PREEMPT_RT; HDMI codec still builds for HDA.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_USB_AUDIO_MIDI_V2=y
CONFIG_SND_UMP_LEGACY_RAWMIDI=y
CONFIG_SND_SEQUENCER=m
CONFIG_SND_SEQ_DUMMY=m
CONFIG_SND_HRTIMER=m
CONFIG_SND_SEQ_HRTIMER_DEFAULT=y

# Local text console on the UEFI GOP framebuffer (no i915 under PREEMPT_RT).
# DRM_FBDEV_EMULATION selects FB_CORE, which FRAMEBUFFER_CONSOLE requires.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

CONFIG_PINCTRL=y
CONFIG_PINCTRL_ALDERLAKE=m
CONFIG_GPIO_SYSFS=y

CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_AUTOFS4_FS=y

# Loop devices, needed by the Singularity runtime to mount SIF images.
CONFIG_BLK_DEV_LOOP=y

# SquashFS, needed by the Singularity runtime to mount SIF images.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# Initramfs support, required to run the obake /etc-overlay init.
CONFIG_BLK_DEV_INITRD=y

# EFI: the firmware boots the per-slot UKI, whose systemd-stub execs the
# kernel, and RAUC's efi backend manages the boot entries via efivarfs.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# FAT/VFAT for the EFI system partition.
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Device-mapper verity, required to mount RAUC verity-format bundles.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_BUFIO=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y

CONFIG_UNWINDER_FRAME_POINTER=y
