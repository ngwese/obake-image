# Auto-mount removable / USB filesystem partitions under /media/<label>.
# Hand off to a systemd oneshot so the mount lands in the host mount namespace
# (systemd-udevd uses PrivateMounts=yes). Match USB bus as well as removable:
# QEMU usb-storage often reports RM=0. Match add|change so late ID_FS_* is not
# missed. Removal is handled by BindsTo= on obake-media-automount@.service.

ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_BUS}=="usb", TAG+="systemd", ENV{SYSTEMD_WANTS}+="obake-media-automount@%k.service"
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_DRIVE_REMOVABLE}=="1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="obake-media-automount@%k.service"

# Whole-disk filesystems (USB stick with no partition table).
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_BUS}=="usb", TAG+="systemd", ENV{SYSTEMD_WANTS}+="obake-media-automount@%k.service"
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_DRIVE_REMOVABLE}=="1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="obake-media-automount@%k.service"
