#!/bin/sh
# obake update client.
#
# Updates are user-initiated only: nothing runs this automatically. `apply`
# obtains a signed RAUC bundle, preferring removable USB media, then the
# configured HTTPS endpoint, and installs it to the inactive slot.
#
# Configuration lives in /etc/obake/update.conf (under the persistent /etc
# overlay, so edits survive reboots and slot switches). Bundle signature
# verification always applies, so a USB or plain-HTTP source is no less
# trustworthy than HTTPS.
set -u

conf="${OBKA_UPDATE_CONF:-/etc/obake/update.conf}"
[ -r "$conf" ] && . "$conf"
: "${https_url:=}"
: "${usb_prefer:=1}"
: "${tls_cacert:=}"
: "${tls_insecure:=0}"
: "${local_bundle:=}"

usage() {
	printf 'usage: obake-update {status|apply [--cleanup] [--reboot] [<bundle-path>]|rollback}\n' >&2
	exit 2
}

# apply/rollback need root (/persist health state, rauc install). Re-exec via
# the narrowly scoped passwordless sudo grant for this binary only — do not
# probe an unrelated command like `sudo true`.
need_root() {
	case "${1:-}" in
	apply | rollback) return 0 ;;
	*) return 1 ;;
	esac
}

if need_root "${1:-}" && [ "$(id -u)" -ne 0 ]; then
	if command -v sudo >/dev/null 2>&1; then
		exec sudo -n -- "$0" "$@"
	fi
	printf 'obake-update: %s requires root (try: sudo obake-update %s)\n' \
		"${1:-}" "${1:-}" >&2
	exit 1
fi

running_version() {
	cat /etc/obake/image-version 2>/dev/null || echo unknown
}

# Bundle downloads can be large, too large for the tmpfs /run, so stage them on
# the user partition when it is available.
stage_path() {
	if mountpoint -q /home 2>/dev/null; then
		dir="/home/.obake-update"
	else
		dir="/run"
	fi
	mkdir -p "$dir" 2>/dev/null || dir="/run"
	printf '%s/obake-update.raucb' "$dir"
}

# Temporary mount under /run/obake-usb.* for partitions automount missed.
# Prints "<mount>\n<bundle>" on success; leaves nothing mounted on failure.
try_mount_bundle() {
	part="$1"
	mnt="$(mktemp -d /run/obake-usb.XXXXXX)" || return 1
	if mount -o ro "$part" "$mnt" 2>/dev/null; then
		bundle="$(find "$mnt" -maxdepth 2 -type f -name '*.raucb' 2>/dev/null | sort | head -1)"
		if [ -n "$bundle" ]; then
			printf '%s\n%s\n' "$mnt" "$bundle"
			return 0
		fi
		umount "$mnt"
	fi
	rmdir "$mnt" 2>/dev/null || true
	return 1
}

# Prefer auto-mounted media under /media; fall back to a root-only probe mount.
# Prints "<mount>\n<bundle>" on success.
find_usb_bundle() {
	for mnt in /media/*; do
		[ -d "$mnt" ] || continue
		mountpoint -q "$mnt" 2>/dev/null || continue
		bundle="$(find "$mnt" -maxdepth 2 -type f -name '*.raucb' 2>/dev/null | sort | head -1)"
		if [ -n "$bundle" ]; then
			printf '%s\n%s\n' "$mnt" "$bundle"
			return 0
		fi
	done

	# Prefer partitions flagged removable (real USB media)...
	for part in $(lsblk -pnro NAME,RM,TYPE 2>/dev/null | awk '$2 == 1 && $3 == "part" { print $1 }'); do
		found="$(try_mount_bundle "$part")" && {
			printf '%s\n' "$found"
			return 0
		}
	done
	# ...then any partition carrying a bundle (QEMU usb-storage reports
	# removable=0, and some media do too).
	for part in $(lsblk -pnro NAME,RM,TYPE 2>/dev/null | awk '$3 == "part" { print $1 }'); do
		found="$(try_mount_bundle "$part")" && {
			printf '%s\n' "$found"
			return 0
		}
	done
	return 1
}

# Only tear down temporary probe mounts; leave system /media mounts alone.
cleanup_usb_mnt() {
	mnt="${1:-}"
	case "$mnt" in
	/run/obake-usb.*)
		umount "$mnt" 2>/dev/null || true
		rmdir "$mnt" 2>/dev/null || true
		;;
	esac
}

fetch_https_bundle() {
	[ -n "$https_url" ] || return 1
	staged="$(stage_path)"
	set -- -fsSL --retry 5 --retry-connrefused --retry-delay 2 -o "$staged"
	[ -n "$tls_cacert" ] && set -- "$@" --cacert "$tls_cacert"
	[ "$tls_insecure" = 1 ] && set -- "$@" -k
	curl "$@" "$https_url" || return 1
	printf '%s' "$staged"
}

cmd_status() {
	printf 'running version: %s\n' "$(running_version)"
	printf 'active slot: %s\n' "$(rauc status 2>/dev/null | sed -n 's/^Booted from: //p')"
	printf 'pending/activated: %s\n' "$(rauc status 2>/dev/null | sed -n 's/^Activated: //p')"
	rauc status >/dev/null 2>&1 || {
		printf 'update state: unavailable (RAUC service not responding)\n'
		return 1
	}
}

# After a successful install: optionally remove an explicit caller path, then
# optionally reboot. Never delete USB/HTTPS-discovered bundles via --cleanup.
apply_success_hooks() {
	explicit_path="$1"
	do_cleanup="$2"
	do_reboot="$3"

	if [ "$do_cleanup" = 1 ]; then
		if [ -n "$explicit_path" ]; then
			rm -f -- "$explicit_path" || {
				printf 'obake-update: failed to remove %s\n' "$explicit_path" >&2
				exit 1
			}
			printf 'obake-update: removed %s\n' "$explicit_path" >&2
		else
			printf 'obake-update: --cleanup ignored (no caller-supplied path)\n' >&2
		fi
	fi

	if [ "$do_reboot" = 1 ]; then
		printf 'obake-update: rebooting\n' >&2
		systemctl reboot
	fi
}

cmd_apply() {
	bundle_path="${1:-}"
	do_cleanup="${2:-0}"
	do_reboot="${3:-0}"

	# Snapshot the shape configuration and mark the update pending before the
	# inactive slot is written, so the health gate can restore on failure.
	id="$(date +%Y%m%d%H%M%S 2>/dev/null || echo manual)"
	/usr/libexec/obake/obake-launcher snapshot "$id" >/dev/null 2>&1 || true
	if ! mkdir -p /persist/obake/health; then
		printf 'obake-update: cannot create /persist/obake/health (is /persist mounted?)\n' >&2
		exit 1
	fi
	if ! printf 'snapshot=%s\nattempts=0\n' "$id" >/persist/obake/health/pending; then
		printf 'obake-update: cannot write /persist/obake/health/pending\n' >&2
		exit 1
	fi

	# Caller-supplied path (same signature check as other sources).
	if [ -n "$bundle_path" ]; then
		if [ ! -f "$bundle_path" ]; then
			printf 'obake-update: bundle not found: %s\n' "$bundle_path" >&2
			exit 1
		fi
		printf 'obake-update: installing %s (local)\n' "$bundle_path" >&2
		if ! rauc install "$bundle_path"; then
			return 1
		fi
		apply_success_hooks "$bundle_path" "$do_cleanup" "$do_reboot"
		return 0
	fi

	# A local bundle (test/development) is used directly when configured.
	if [ -n "$local_bundle" ] && [ -f "$local_bundle" ]; then
		printf 'obake-update: installing %s (local)\n' "$local_bundle" >&2
		if ! rauc install "$local_bundle"; then
			return 1
		fi
		# Configured local_bundle is not a caller-supplied apply path.
		apply_success_hooks "" "$do_cleanup" "$do_reboot"
		return 0
	fi

	# Prefer USB when configured and present (/media first, then probe mount).
	if [ "$usb_prefer" = 1 ]; then
		if found="$(find_usb_bundle 2>/dev/null)"; then
			mnt="$(printf '%s\n' "$found" | sed -n 1p)"
			bundle="$(printf '%s\n' "$found" | sed -n 2p)"
			printf 'obake-update: installing %s (USB)\n' "$bundle" >&2
			if ! rauc install "$bundle"; then
				cleanup_usb_mnt "$mnt"
				return 1
			fi
			cleanup_usb_mnt "$mnt"
			apply_success_hooks "" "$do_cleanup" "$do_reboot"
			return 0
		fi
	fi

	bundle="$(fetch_https_bundle 2>/dev/null)" || bundle=""
	if [ -n "$bundle" ]; then
		printf 'obake-update: installing %s (HTTPS)\n' "$bundle" >&2
		if ! rauc install "$bundle"; then
			return 1
		fi
		apply_success_hooks "" "$do_cleanup" "$do_reboot"
		return 0
	fi

	# Last resort: USB even when not preferred.
	if found="$(find_usb_bundle 2>/dev/null)"; then
		mnt="$(printf '%s\n' "$found" | sed -n 1p)"
		bundle="$(printf '%s\n' "$found" | sed -n 2p)"
		printf 'obake-update: installing %s (USB)\n' "$bundle" >&2
		if ! rauc install "$bundle"; then
			cleanup_usb_mnt "$mnt"
			return 1
		fi
		cleanup_usb_mnt "$mnt"
		apply_success_hooks "" "$do_cleanup" "$do_reboot"
		return 0
	fi

	printf 'obake-update: no update bundle available\n' >&2
	exit 1
}

cmd_rollback() {
	cur="$(rauc status 2>/dev/null | sed -n 's/^Booted from: \(rootfs\.[01]\).*/\1/p')"
	if [ -z "$cur" ]; then
		printf 'obake-update: cannot determine the booted slot\n' >&2
		exit 1
	fi
	printf 'obake-update: booted %s; reverting to the previous slot\n' "$cur" >&2
	rauc status mark-bad "$cur" >/dev/null 2>&1 || true
	if ! rauc status mark-active other >/dev/null 2>&1; then
		printf 'obake-update: failed to activate the previous slot\n' >&2
		exit 1
	fi
	# Best effort: restore the configuration snapshot taken before the update
	# and clear any pending health-gate state.
	/usr/libexec/obake/obake-launcher restore >/dev/null 2>&1 || true
	rm -f /persist/obake/health/pending 2>/dev/null || true
	printf 'obake-update: previous slot activated; reboot to complete the rollback\n'
}

case "${1:-}" in
status)
	cmd_status
	;;
apply)
	shift
	do_cleanup=0
	do_reboot=0
	bundle_path=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--cleanup)
			do_cleanup=1
			;;
		--reboot)
			do_reboot=1
			;;
		-*)
			printf 'obake-update: unknown apply flag: %s\n' "$1" >&2
			usage
			;;
		*)
			if [ -n "$bundle_path" ]; then
				printf 'obake-update: unexpected argument: %s\n' "$1" >&2
				usage
			fi
			bundle_path=$1
			;;
		esac
		shift
	done
	cmd_apply "$bundle_path" "$do_cleanup" "$do_reboot"
	;;
rollback)
	cmd_rollback
	;;
*)
	usage
	;;
esac
