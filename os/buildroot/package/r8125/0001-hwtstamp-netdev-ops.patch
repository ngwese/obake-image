+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6,6,0)
+int rtl8125_ndo_hwtstamp_get(struct net_device *netdev,
+                             struct kernel_hwtstamp_config *config)
+{
+        int ret;
+
+        if (!config->ifr)
+                return -EOPNOTSUPP;
+
+        ret = rtl8125_get_tstamp(netdev, config->ifr);
+        if (!ret)
+                config->copied_to_user = true;
+        return ret;
+}
+
+int rtl8125_ndo_hwtstamp_set(struct net_device *netdev,
+                             struct kernel_hwtstamp_config *config,
+                             struct netlink_ext_ack *extack)
+{
+        int ret;
+
+        (void)extack;
+
+        if (!config->ifr)
+                return -EOPNOTSUPP;
+
+        ret = rtl8125_set_tstamp(netdev, config->ifr);
+        if (!ret)
+                config->copied_to_user = true;
+        return ret;
+}
+#endif /* LINUX_VERSION_CODE >= KERNEL_VERSION(6,6,0) */
