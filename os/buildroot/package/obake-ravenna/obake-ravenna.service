[Unit]
Description=obake RAVENNA session daemon
Documentation=file:/usr/share/obake/obake-ravenna/config.toml
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/obake-ravenna run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure

[Install]
WantedBy=default.target
