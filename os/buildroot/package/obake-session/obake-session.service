[Unit]
Description=obake rig session daemon
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
Environment=RUST_LOG=info
ExecStart=/usr/bin/obake-session run
Restart=on-failure

[Install]
WantedBy=default.target
