config BR2_PACKAGE_OBAKE_JACK2
	bool "obake jack2 (jackd + jackdbus, no Python)"
	depends on BR2_TOOLCHAIN_HAS_THREADS # alsa-lib, dbus
	depends on BR2_USE_MMU # fork()
	depends on BR2_INSTALL_LIBSTDCPP
	depends on !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_HAS_SYNC_4
	depends on BR2_USE_WCHAR # dbus
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ALSA_LIB_HWDEP
	select BR2_PACKAGE_ALSA_LIB_SEQ
	select BR2_PACKAGE_ALSA_LIB_RAWMIDI
	select BR2_PACKAGE_DBUS
	select BR2_PACKAGE_EXPAT
	help
	  jack2 built with the classic server (jackd) and D-Bus support
	  (jackdbus). The Python jack_control helper is removed and no Python
	  runtime is selected; drive jackdbus over its D-Bus interface.

	  Use this instead of the in-tree jack2 when the D-Bus control
	  interface is wanted but the Python CLI is not.
