config BR2_PACKAGE_SINGULARITY
	bool "singularity-ce"
	depends on BR2_PACKAGE_HOST_GO_TARGET_ARCH_SUPPORTS
	depends on BR2_USE_MMU # go, fork
	depends on BR2_TOOLCHAIN_HAS_THREADS # go
	depends on BR2_USE_WCHAR
	depends on !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_HAS_SYNC_4
	select BR2_PACKAGE_LIBSECCOMP
	select BR2_PACKAGE_LIBGPGME
	select BR2_PACKAGE_CRYPTSETUP
	select BR2_PACKAGE_LIBFUSE3
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_LZ4
	select BR2_PACKAGE_XZ
	select BR2_PACKAGE_ZSTD
	select BR2_PACKAGE_LZO
	select BR2_PACKAGE_UTIL_LINUX
	select BR2_PACKAGE_E2FSPROGS
	select BR2_PACKAGE_SQUASHFS
	help
	  SingularityCE container runtime, built from source at a pinned
	  version. This is the runtime the shapes run on.

	  Built with the setuid helper (kernel SquashFS SIF mounts) and
	  without libsubid (local /etc/subuid and /etc/subgid only).

comment "singularity-ce needs a toolchain w/ threads, wchar, dynamic library"
	depends on !BR2_TOOLCHAIN_HAS_THREADS || !BR2_USE_WCHAR || BR2_STATIC_LIBS
