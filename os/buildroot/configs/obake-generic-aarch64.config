# generic board, aarch64 (the QEMU virt proxy for the arm64 boards).
BR2_aarch64=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OBAKE_PATH)/board/obake/rootfs-overlay $(BR2_EXTERNAL_OBAKE_PATH)/board/obake/generic-aarch64/rootfs-overlay"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_OBAKE_PATH)/board/obake/generic-aarch64/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
