# obake shared Buildroot base configuration.
#
# This file is the single common base for every obake board. build.sh composes
# it with a board fragment (configs/obake-<board>.config) to form the defconfig
# Buildroot configures from, so the base userland, kernel source, and runtime
# are identical on every board and a board can only add to or override them.
#
# Arch (BR2_aarch64/BR2_x86_64), the kernel config file, the board rootfs
# overlay, and any board-only packages live in the board fragment, never here.

BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_19=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
# Build reproducibly: a fixed SOURCE_DATE_EPOCH and normalized paths/timezone,
# so rebuilding from unchanged pins yields a byte-identical rootfs archive.
BR2_REPRODUCIBLE=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_OBAKE_PATH)/board/obake/patches"
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_OBAKE_PATH)/board/obake/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_OBAKE_PATH)/board/obake/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_OBAKE_PATH)/board/obake/post-image.sh"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_OBAKE_PATH)/board/obake/users.txt"
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_LINUX_PAM=y
BR2_PACKAGE_SYSTEMD_LOGIND=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_SYSTEMD_POLKIT=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_GREP=y
BR2_PACKAGE_VIM=y
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_DBUS=y
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_EFIBOOTMGR=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_MOUNTPOINT=y
BR2_PACKAGE_OBAKE_HOST_CONFIG=y
BR2_PACKAGE_OBAKE_RUNTIME=y
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.2.9"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_OBAKE_PATH)/board/obake/linux-realtime.fragment $(BR2_EXTERNAL_OBAKE_PATH)/board/obake/linux-obake.fragment"
BR2_TARGET_GENERIC_ISSUE="Welcome to obake-os"
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1G"
BR2_TARGET_ROOTFS_TAR=y
BR2_PRIMARY_SITE="https://sources.buildroot.net"
