# qdl board, x86_64: MeLE Quieter DL (Intel N100, dual RTL8125 via r8125).
BR2_x86_64=y
BR2_PACKAGE_R8125=y
BR2_PACKAGE_LINUXPTP=y
BR2_PACKAGE_OBAKE_RAVENNA=y
BR2_PACKAGE_SYSTEMD_BOOT=y

BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OBAKE_PATH)/board/obake/rootfs-overlay $(BR2_EXTERNAL_OBAKE_PATH)/board/obake/qdl/rootfs-overlay"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_OBAKE_PATH)/board/obake/qdl/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
