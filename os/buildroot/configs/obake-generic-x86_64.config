# generic board, x86_64 (development and CI hosts).
BR2_x86_64=y
BR2_PACKAGE_SYSTEMD_BOOT=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OBAKE_PATH)/board/obake/rootfs-overlay $(BR2_EXTERNAL_OBAKE_PATH)/board/obake/generic-x86_64/rootfs-overlay"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_OBAKE_PATH)/board/obake/generic-x86_64/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
